# Keep the pages.dev production alias and branch previews out of search
# results so hadsed.com is the only copy that gets indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Caching. Pages stay max-age=0 (Cloudflare's default) so a vault edit shows up on the next visit.
# Fonts never change under the same name, and site.css is linked as /css/site.css?v=<content hash>
# (base.njk), so both can stay in the browser for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

# Images and other media keep their names when edited: a day fresh, then revalidated in the background.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/feed.xml
  Content-Type: application/atom+xml; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
