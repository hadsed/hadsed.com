---
layout: base.njk
description: "Posts by Had Seddiqi on applying AI to hard science and engineering problems."
title: Blog
permalink: /blog/
---
<h2 class="label">Blog</h2>
{%- if collections.blog.length %}
<ul class="posts">
{%- for post in collections.blog %}
  {%- set hero = site.heroByUrl[post.url] %}
  <li{% if hero %} class="has-hero"{% endif %}>
    {%- if hero %}<a class="card-hero-link" href="{{ post.url }}" tabindex="-1" aria-hidden="true">{{ hero | heroHtml("", true) | safe }}</a>{% endif %}
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <span class="dates">{{ post.date | readableDate }}</span>
    {%- if post.data.summary %}<p class="summary">{{ post.data.summary }}</p>{% endif %}
  </li>
{%- endfor %}
</ul>
{%- else %}
<p class="meta">Nothing here yet.</p>
{%- endif %}
