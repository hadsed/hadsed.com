---
layout: base.njk
title: Blog
permalink: /blog/
---
<h2 class="label">Blog</h2>
{%- if collections.blog.length %}
<ul class="posts">
{%- for post in collections.blog %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <span class="dates">{{ post.date | readableDate }}</span>
    {%- if post.data.summary %}<p class="summary">{{ post.data.summary }}</p>{% endif %}
  </li>
{%- endfor %}
</ul>
{%- else %}
<p class="meta">Nothing here yet.</p>
{%- endif %}
