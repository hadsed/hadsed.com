---
layout: base.njk
title: Blog
permalink: /blog/
---
<h2 class="label">Blog</h2>
<ul class="posts">
{%- for post in collections.articles | reverse %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <span class="dates">{{ post.date | readableDate }}</span>
    <p class="summary">{{ post.data.summary }}</p>
  </li>
{%- endfor %}
</ul>
