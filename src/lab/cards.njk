---
layout: base.njk
title: Project layouts
permalink: /lab/cards/
eleventyExcludeFromCollections: true
---
{#- Previews only (src/lab/ is never built for production): ways to show projects and posts with
    their hero images, built from the real content. Hover anything with a picture to play it. -#}
<style>
  .opt { margin: 0 0 5rem; }
  .opt-label { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--glow); margin: 0 0 0.3rem; }
  .opt-how { color: var(--muted); font-size: 0.85rem; margin: 0 0 1.5rem; max-width: 40rem; }
  .jump { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin: 0 0 3rem; font-size: 0.85rem; }

  /* Shared type: the title is the serif heading face, bright; the summary is small sans, muted. */
  .t-title { font-family: Petrona, Georgia, serif; font-weight: 400; color: var(--bright, #f4f6f8); line-height: 1.2; margin: 0; }
  .t-title a { color: inherit; text-decoration: none; }
  .t-title a:hover { color: var(--glow); }
  .t-sum { color: var(--muted); font-size: 0.88rem; line-height: 1.5; margin: 0.35rem 0 0; }
  .t-meta { color: color-mix(in srgb, var(--muted) 75%, transparent); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 0.4rem; font-variant-numeric: tabular-nums; }

  /* Picture box: still frame, motion laid over it when it plays. */
  .pic { display: block; position: relative; overflow: hidden; background: #0f1520; border-radius: 2px; }
  .pic .card-hero, .pic img, .pic .hero-motion { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pic .hero-motion { opacity: 0; transition: opacity 0.15s; }
  .pic .playing .hero-motion { opacity: 1; }

  /* A / B: grids */
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1rem; align-items: start; }
  .grid .card { border: 1px solid color-mix(in srgb, var(--rule) 70%, transparent); border-radius: 3px; overflow: hidden; background: rgba(15, 21, 32, 0.35); transition: border-color 0.15s; }
  .grid .card:hover { border-color: var(--glow); }
  .grid .pic { aspect-ratio: 16 / 9; border-radius: 0; }
  .grid .body { padding: 0.95rem 1.1rem 1.1rem; }
  .grid .t-title { font-size: 1.3rem; }
  .opt-b .grid { align-items: stretch; }
  .ph { position: absolute; inset: 0; display: grid; place-items: center; font-family: Petrona, Georgia, serif; font-weight: 300; font-size: 2.6rem;
    color: color-mix(in srgb, var(--muted) 45%, transparent);
    background: repeating-linear-gradient(135deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 12px), #141b28; }

  /* C: editorial index. Numbered rows; the hero floats in beside the list while its row is hovered. */
  .ix-wrap { position: relative; padding-right: 22rem; }
  .ix { list-style: none; margin: 0; padding: 0; border-top: 1px solid color-mix(in srgb, var(--rule) 35%, transparent); }
  .ix li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) auto; gap: 0 1rem; align-items: baseline; padding: 1.15rem 0.25rem; border-bottom: 1px solid color-mix(in srgb, var(--rule) 35%, transparent); }
  .ix .n { font-family: Petrona, Georgia, serif; font-size: 0.95rem; color: var(--glow); font-variant-numeric: tabular-nums; }
  .ix .t-title { font-size: 1.65rem; font-weight: 300; }
  .ix .yr { color: var(--muted); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .ix li:hover .t-title { color: var(--glow); }
  .ix .float { position: absolute; right: 0; top: 0; width: 20rem; aspect-ratio: 16 / 9; opacity: 0; transform: translateY(0.5rem); transition: opacity 0.2s, transform 0.2s; pointer-events: none; box-shadow: 0 12px 40px rgba(0,0,0,0.45); }
  .ix li:hover .float { opacity: 1; transform: none; }

  /* D: one feature, then the rest as a quiet index */
  .feat { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 2rem; align-items: center; margin: 0 0 2rem; }
  .feat .pic { aspect-ratio: 16 / 10; }
  .feat .t-title { font-size: 2.1rem; font-weight: 300; }
  .feat .t-sum { font-size: 0.95rem; max-width: 26rem; }
  .feat .more { display: inline-block; margin-top: 1rem; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--glow); text-decoration: none; }
  .rest { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1.5rem 2rem; border-top: 1px solid color-mix(in srgb, var(--rule) 35%, transparent); padding-top: 1.5rem; }
  .rest .t-title { font-size: 1.2rem; }

  /* E: timeline spine, like the Experience column */
  .tl { list-style: none; margin: 0; padding: 0 0 0 1.4rem; border-left: 1px solid color-mix(in srgb, var(--rule) 45%, transparent); max-width: 46rem; }
  .tl li { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 10rem; gap: 1.5rem; align-items: start; padding: 0 0 2.25rem; }
  .tl li::before { content: ""; position: absolute; left: calc(-1.4rem - 4px); top: 0.55rem; width: 7px; height: 7px; border-radius: 50%; background: var(--muted); }
  .tl li:first-child::before { background: var(--glow); box-shadow: 0 0 0 4px color-mix(in srgb, var(--glow) 18%, transparent); }
  .tl .t-title { font-size: 1.45rem; }
  .tl .pic { aspect-ratio: 16 / 10; }

  /* Blog rows */
  .bl { list-style: none; margin: 0; padding: 0; max-width: 44rem; }
  .bl li { display: grid; grid-template-columns: minmax(0, 1fr) 9rem; gap: 1.5rem; align-items: start; padding: 1.25rem 0; border-bottom: 1px solid color-mix(in srgb, var(--rule) 30%, transparent); }
  .bl li:not(:has(.pic)) { grid-template-columns: minmax(0, 1fr); }
  .bl .t-title { font-size: 1.45rem; }
  .bl .pic { aspect-ratio: 4 / 3; }

  @media (max-width: 1100px) { .ix .float { display: none; } .ix-wrap { padding-right: 0; } }
  @media (max-width: 40rem) {
    .feat { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .feat .t-title { font-size: 1.7rem; }
    .ix li { grid-template-columns: 2rem minmax(0, 1fr); }
    .ix .yr { grid-column: 2; }
    .ix .t-title { font-size: 1.35rem; }
    .tl li { grid-template-columns: minmax(0, 1fr) 5.5rem; gap: 1rem; }
    .tl .t-title { font-size: 1.25rem; }
    .bl li { grid-template-columns: minmax(0, 1fr) 5.5rem; gap: 1rem; }
    .bl .t-title { font-size: 1.25rem; }
  }
  @media (hover: none) { .ix .float { display: none; } .ix-wrap { padding-right: 0; } }
</style>

{%- macro pic(item, cls = "") -%}
<a class="pic {{ cls }}" href="{{ item.url }}" tabindex="-1" aria-hidden="true">{{ item.hero | heroHtml("", true) | safe }}</a>
{%- endmacro %}
{%- macro meta(item) -%}{% if item.started %}{{ item.started | monthYear }}{% endif %}{%- endmacro %}

<h2 class="label">Project layouts</h2>
<p class="meta">Real projects and posts. Hover anything with a picture to play it. Nothing here is on the live site.</p>
<nav class="jump"><a href="#a">A. Band grid</a><a href="#b">B. Slot grid</a><a href="#c">C. Index</a><a href="#d">D. Feature + list</a><a href="#e">E. Timeline</a><a href="#blog">Blog rows</a></nav>

<section class="opt opt-a" id="a">
  <p class="opt-label">A · Grid, picture band where there is one</p>
  <p class="opt-how">Natural heights. Serif titles, muted summaries, no badge or counts.</p>
  <div class="grid">
  {%- for item in site.projects %}
    <article class="card" data-hero-area>
      {%- if item.hero %}{{ pic(item) }}{% endif %}
      <div class="body"><p class="t-meta">{{ meta(item) }}</p><h3 class="t-title"><a href="{{ item.url }}">{{ item.title }}</a></h3><p class="t-sum">{{ item.summary }}</p></div>
    </article>
  {%- endfor %}
  </div>
</section>

<section class="opt opt-b" id="b">
  <p class="opt-label">B · Grid, same picture slot on every card</p>
  <p class="opt-how">Projects without a hero get a quiet placeholder with their initial, so the row lines up.</p>
  <div class="grid">
  {%- for item in site.projects %}
    <article class="card" data-hero-area>
      {%- if item.hero %}{{ pic(item) }}{% else %}<a class="pic" href="{{ item.url }}" tabindex="-1" aria-hidden="true"><span class="ph">{{ item.title | first }}</span></a>{% endif %}
      <div class="body"><p class="t-meta">{{ meta(item) }}</p><h3 class="t-title"><a href="{{ item.url }}">{{ item.title }}</a></h3><p class="t-sum">{{ item.summary }}</p></div>
    </article>
  {%- endfor %}
  </div>
</section>

<section class="opt opt-c" id="c">
  <p class="opt-label">C · Index</p>
  <p class="opt-how">A numbered list of big serif titles, like a magazine contents page. Hovering a row floats its picture in beside the list and plays it. No picture boxes sit on the page until you hover.</p>
  <div class="ix-wrap"><ol class="ix">
  {%- for item in site.projects %}
    <li data-hero-area>
      <span class="n">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
      <div><h3 class="t-title"><a href="{{ item.url }}">{{ item.title }}</a></h3><p class="t-sum">{{ item.summary }}</p></div>
      <span class="yr">{{ meta(item) }}</span>
      {%- if item.hero %}{{ pic(item, "float") }}{% endif %}
    </li>
  {%- endfor %}
  </ol></div>
</section>

<section class="opt opt-d" id="d">
  <p class="opt-label">D · Feature + list</p>
  <p class="opt-how">The most recent project with a picture gets a wide feature row; the rest sit below as a quiet text list. The picture decides what leads.</p>
  {%- set featured = site.projects | selectattr("hero") | first %}
  {%- if featured %}
  <article class="feat" data-hero-area>
    {{ pic(featured) }}
    <div><p class="t-meta">{{ meta(featured) }}</p><h3 class="t-title"><a href="{{ featured.url }}">{{ featured.title }}</a></h3><p class="t-sum">{{ featured.summary }}</p><a class="more" href="{{ featured.url }}">Read more</a></div>
  </article>
  {%- endif %}
  <ul class="rest">
  {%- for item in site.projects %}{% if item.url != featured.url %}
    <li><p class="t-meta">{{ meta(item) }}</p><h3 class="t-title"><a href="{{ item.url }}">{{ item.title }}</a></h3><p class="t-sum">{{ item.summary }}</p></li>
  {%- endif %}{% endfor %}
  </ul>
</section>

<section class="opt opt-e" id="e">
  <p class="opt-label">E · Timeline</p>
  <p class="opt-how">Projects on a spine like the Experience column, newest on top with a gold dot. A picture sits to the right where there is one.</p>
  <ol class="tl">
  {%- for item in site.projects %}
    <li data-hero-area>
      <div><p class="t-meta">{{ meta(item) }}</p><h3 class="t-title"><a href="{{ item.url }}">{{ item.title }}</a></h3><p class="t-sum">{{ item.summary }}</p></div>
      {%- if item.hero %}{{ pic(item) }}{% endif %}
    </li>
  {%- endfor %}
  </ol>
</section>

<section class="opt" id="blog">
  <p class="opt-label">Blog rows</p>
  <p class="opt-how">Date above, serif title, muted summary, picture on the right. Goes with any of the above.</p>
  <ul class="bl">
  {%- for post in collections.blog %}
    {%- set hero = site.heroByUrl[post.url] %}
    <li data-hero-area>
      <div><p class="t-meta">{{ post.date | shortDate }}</p><h3 class="t-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      {%- if post.data.summary %}<p class="t-sum">{{ post.data.summary }}</p>{% endif %}</div>
      {%- if hero %}<a class="pic" href="{{ post.url }}" tabindex="-1" aria-hidden="true">{{ hero | heroHtml("", true) | safe }}</a>{% endif %}
    </li>
  {%- endfor %}
  </ul>
</section>
