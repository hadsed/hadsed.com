{#- Table of contents from the post's own headings (lib/article.mjs tocFrom): sections, then their subsections. -#}
<ol class="toc">
  {%- for h in toc %}
  {%- if h.depth == 1 %}
  {%- if not loop.first %}</ol></li>{% endif %}
  <li class="toc-1"><a href="#{{ h.id }}">{{ h.text }}</a><ol>
  {%- else %}
  {%- if loop.first %}<li class="toc-1"><ol>{% endif %}
    <li class="toc-2"><a href="#{{ h.id }}">{{ h.text }}</a></li>
  {%- endif %}
  {%- if loop.last %}</ol></li>{% endif %}
  {%- endfor %}
</ol>
{#- The side list marks the section being read. -#}
<script>(function () {
  var side = document.currentScript.closest('.toc-side'); if (!side || side.dataset.spy) return;
  side.dataset.spy = 1;
  var links = [].slice.call(side.querySelectorAll('a[href^="#"]'));
  var heads = links.map(function (a) { return document.getElementById(decodeURIComponent(a.hash.slice(1))); });
  var current = null;
  function mark() {
    var line = innerHeight * 0.25, at = -1;
    for (var i = 0; i < heads.length; i++) { if (heads[i] && heads[i].getBoundingClientRect().top <= line) at = i; }
    var a = links[at] || null;
    if (a === current) return;
    if (current) { current.removeAttribute('aria-current'); current.closest('.toc-1').classList.remove('open'); }
    current = a;
    if (a) {
      a.closest('.toc-1').classList.add('open');
      a.setAttribute('aria-current', 'location');
      var r = a.getBoundingClientRect(), s = side.getBoundingClientRect();
      if (r.top < s.top + 40 || r.bottom > s.bottom - 40) side.scrollTop += r.top - s.top - s.height / 3;
    }
  }
  addEventListener('scroll', mark, { passive: true });
  addEventListener('load', mark);
  mark();
})();</script>
