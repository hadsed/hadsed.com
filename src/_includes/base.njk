<!DOCTYPE html>
<html lang="en" data-hero-motion="{{ heroMotion }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set heroSrc = hero_image or (page.inputPath | leadImage).src %}
  {%- set pageTitle %}{% if title %}{{ title }} · Had Seddiqi{% else %}Had Seddiqi{% endif %}{% endset %}
  {%- set pageDescription = description or summary or "Applying AI to hard science and engineering problems." %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="https://hadsed.com{{ page.url }}">
  {%- endif %}
  {#- A top-level visit hands over to /lab/home/, which shows this page over the live sky with Fly.
      Inside that frame (or for crawlers, link previews and browsers without WebGL) the page stays as is. #}
  <script>(function () {
    try {
      if (window.top !== window || /bot|crawl|spider|slurp|preview|facebookexternalhit|embedly|lighthouse/i.test(navigator.userAgent)) return;
      var c = document.createElement('canvas');
      if (!(c.getContext('webgl2') || c.getContext('webgl'))) return;
      location.replace('/lab/home/?p=' + encodeURIComponent(location.pathname + location.search) + location.hash);
    } catch (e) {}
  })();</script>
  {%- if "blog" in (tags or []) %}
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  {%- else %}
  <meta property="og:type" content="website">
  {%- endif %}
  <meta property="og:site_name" content="Had Seddiqi">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="https://hadsed.com{{ page.url }}">
  {#- Link preview: share_image (a 1200x630 file in assets/, alt from share_image_alt or the title), else the
      page's hero (heroSrc, set where hero images are rendered), else og.jpg. #}
  {%- if share_image %}
  <meta property="og:image" content="{{ siteUrl }}{{ share_image | assetUrl }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ share_image_alt or title }}">
  {%- elif heroSrc %}
  <meta property="og:image" content="{{ siteUrl }}{{ heroSrc | assetUrl and heroSrc | heroShareUrl }}">
  <meta property="og:image:alt" content="Had Seddiqi, hadsed.com">
  {%- else %}
  <meta property="og:image" content="{{ siteUrl }}/assets/og.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Had Seddiqi, hadsed.com">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {#- Petrona (self-hosted, src/fonts) only sets the name on the home page: preload it there, nowhere else. #}
  {%- if page.url == "/" %}
  <link rel="preload" href="/fonts/petrona-300-latin.woff2" as="font" type="font/woff2" crossorigin>
  {%- endif %}
  {#- Inline (src/css/site.css, via eleventy.config.js): no request stands between the HTML and its text. #}
  <style>{{ siteCss | safe }}</style>
  <link rel="alternate" type="application/atom+xml" title="Blog" href="/feed.xml">
  {%- if not noindex %}
  <script type="application/ld+json">
  {{ page | structuredData(title, pageDescription, collections.about[0].data, site) | dump | replace("<", "\\u003c") | safe }}
  </script>
  {%- endif %}
  {#- Framed by the home's 3D backdrop: let it dress the page before first paint (no flicker on navigation). -#}
  <script>try { if (window.frameElement && frameElement.id === 'site' && parent.__siteHook) parent.__siteHook(document); } catch (e) {}</script>
</head>
<body>
<div class="page">
  <nav class="menu">
    {#- On every page, the landing page included, so the menu sits at the same height everywhere (hidden on phones). #}
    <a class="site-name" href="/">Had Seddiqi</a>
    {#- Two groups: who (About, Experience), then what (Projects, Blog, Notes). The items sit in
        their own list so the home's Fly button (added after it) stays put while, on phones,
        the row scrolls sideways and fades out half-cut into Fly. -#}
    <ul class="nav"><li class="nav-scroll"><ul>
      {%- set items = [["/", "About"], ["/experience/", "Experience"], ["", ""], ["/projects/", "Projects"], ["/blog/", "Blog"], ["/notes/", "Notes"]] -%}
      {%- for item in items -%}
        {%- set href = item[0] -%}
        {%- if not href -%}
        <li class="nav-gap" aria-hidden="true"></li>
        {%- else -%}
        {%- set current = (href == "/" and page.url == "/") or (href != "/" and page.url.startsWith(href)) -%}
        <li><a{% if current %} aria-current="page"{% endif %} href="{{ href }}">{{ item[1] }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul></li></ul>
  </nav>
  <main>
{{ content | safe }}
  </main>
</div>
<footer>© {{ buildYear }} Had Seddiqi</footer>
<script>(function () {
  // Phones: the menu row scrolls sideways. Fade its left edge only while an item is cut there, drop
  // the right fade at the end, and start with the current page's item in view.
  var ul = document.querySelector('.nav-scroll > ul'); if (!ul) return;
  function items() { return [].filter.call(ul.children, function (li) { return li.offsetWidth; }); }
  function mark() {
    var left = ul.getBoundingClientRect().left;
    ul.classList.toggle('scrolled', items().some(function (li) {
      var r = li.getBoundingClientRect(); return r.left < left - 1 && r.right > left + 1;
    }));
    ul.classList.toggle('at-end', ul.scrollLeft + ul.clientWidth >= ul.scrollWidth - 2);
  }
  ul.addEventListener('scroll', mark, { passive: true });
  addEventListener('load', function () {
    var cur = ul.querySelector('[aria-current="page"]');
    if (cur && ul.scrollWidth > ul.clientWidth) {
      // Scroll only when the current item is cut off, and then so the row starts on a whole item.
      var box = ul.getBoundingClientRect(), right = cur.getBoundingClientRect().right;
      if (right > box.right) {
        var need = right - box.right + 4;
        var pad = parseFloat(getComputedStyle(ul).paddingLeft) || 0;
        var starts = items().map(function (li) { return li.getBoundingClientRect().left - box.left + ul.scrollLeft - pad; });
        var to = starts.filter(function (x) { return x >= need; })[0];
        if (to != null) {
          var room = ul.scrollWidth - ul.clientWidth;
          if (to > room) ul.style.paddingRight = (to - room) + 'px';
          ul.scrollLeft = to;
        }
      }
    }
    mark();
  });
})();</script>
<script src="{{ '/assets/hero.js' | busted }}" defer></script>
{%- if analytics.on %}
{#- PostHog (lib/analytics.mjs): pageviews, time on page, clicks, scroll, heatmaps, replay. Text first:
    nothing loads until this page has finished loading and the browser is idle, so it never competes
    with the words. Through /ingest on this site (functions/ingest), not posthog.com. #}
<script>(function () {
  if (/lighthouse|pagespeed|gtmetrix/i.test(navigator.userAgent) || /^(localhost|127\.)/.test(location.hostname)) return;
  // Framed by the home's sky wrapper, the first page is about:srcdoc: report the address it stands at.
  var src = location.href === 'about:srcdoc', top_;
  try { top_ = src ? parent.location : null; } catch (e) {}
  var origin = (window.origin && window.origin !== 'null') ? window.origin : (top_ ? top_.origin : 'https://hadsed.com');
  // Europe (EU and UK law want consent for stored ids): this tab only, nothing kept between visits.
  var tz = ''; try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
  var eu = /^Europe\/|^Atlantic\/(Canary|Madeira|Azores|Faroe|Reykjavik)/.test(tz);
  function start() {
    var s = document.createElement('script');
    s.src = origin + '/ingest/static/array.js'; s.async = true; s.crossOrigin = 'anonymous';
    s.onload = function () {
      var ph = window.posthog; if (!ph || !ph.init) return;
      ph.init({{ analytics.key | dump | safe }}, {
        api_host: origin + '/ingest', ui_host: {{ analytics.ui | dump | safe }},
        person_profiles: 'always',
        opt_out_useragent_filter: true,   // keep headless browsers and agents too, tagged $browser_type: bot
        disable_surveys: true,
        persistence: eu ? 'sessionStorage' : 'localStorage+cookie',
        capture_pageview: true, capture_pageleave: true,
        autocapture: true, enable_heatmaps: true, capture_dead_clicks: true,
        session_recording: { maskAllInputs: true, recordCrossOriginIframes: false },
        before_send: function (ev) {
          if (src && top_ && ev && ev.properties) {
            ev.properties.$current_url = top_.href; ev.properties.$pathname = top_.pathname; ev.properties.$host = top_.host;
            if (!ev.properties.$referrer || ev.properties.$referrer === '$direct' || ev.properties.$referrer === top_.href || /^about:/.test(ev.properties.$referrer)) {
              var r = ''; try { r = parent.document.referrer; } catch (e) {}
              ev.properties.$referrer = r || '$direct';
              ev.properties.$referring_domain = r ? r.split('/')[2] : '$direct';
            }
          }
          return ev;
        },
        loaded: function (p) {
          p.register({ site: 'hadsed.com', in_sky: !!(window.frameElement && frameElement.id === 'site'),
            webdriver: !!navigator.webdriver, eu_mode: eu, time_zone: tz });
          var landing = ''; try { landing = src ? parent.document.referrer : document.referrer; } catch (e) {}
          p.register_once({ landing_referrer: landing || '$direct', landing_page: src && top_ ? top_.pathname : location.pathname });
        }
      });
    };
    document.head.appendChild(s);
  }
  function idle() { (window.requestIdleCallback || function (f) { setTimeout(f, 1500); })(start, { timeout: 4000 }); }
  if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
})();</script>
{%- endif %}
</body>
</html>
