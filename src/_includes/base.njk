<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle %}{% if title %}{{ title }} · Had Seddiqi{% else %}Had Seddiqi{% endif %}{% endset %}
  {%- set pageDescription = description or summary or "Applying AI to hard science and engineering problems." %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="https://hadsed.com{{ page.url }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Had Seddiqi">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="https://hadsed.com{{ page.url }}">
  <meta property="og:image" content="{{ siteUrl }}/assets/og.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Had Seddiqi, hadsed.com">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Petrona:wght@300&display=swap">
  <link rel="stylesheet" href="/css/site.css">
  {%- if page.url == "/" %}
  {%- set about = collections.about[0].data %}
  <script type="application/ld+json">
  {{ {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": about.name,
    "url": "https://hadsed.com/",
    "image": "https://hadsed.com/assets/avatar.jpg",
    "description": pageDescription,
    "sameAs": about.links | profileUrls
  } | dump | safe }}
  </script>
  {%- endif %}
</head>
<body>
<div class="page">
  <nav class="menu">
    {%- if page.url != "/" %}
    <a class="site-name" href="/">Had Seddiqi</a>
    {%- endif %}
    <ul>
      {%- set items = [["/", "About"], ["/portfolio/", "Portfolio"], ["/experience/", "Experience"], ["/blog/", "Blog"]] -%}
      {%- for item in items -%}
        {%- set href = item[0] -%}
        {%- set current = (href == "/" and page.url == "/") or (href != "/" and page.url.startsWith(href)) -%}
        <li><a{% if current %} aria-current="page"{% endif %} href="{{ href }}">{{ item[1] }}</a></li>
      {%- endfor -%}
    </ul>
  </nav>
  <main>
{{ content | safe }}
  </main>
</div>
<footer>© {{ buildYear }} Had Seddiqi</footer>
</body>
</html>
