{#- Consumes: roles (sorted experience items), detailed (bool) -#}
<ol class="timeline">
{%- for item in roles %}
  <li class="timeline-entry" style="--i: {{ loop.index0 }}">
    <span class="orb" aria-hidden="true"></span>
    <div class="entry-head">
      <span class="org">{{ item.data.org }}</span>
      <span class="dates">{{ item.data.start | year }} – {% if item.data.end %}{{ item.data.end | year }}{% else %}now{% endif %}</span>
    </div>
    <div class="role">{{ item.data.role }} · {{ item.data.subtitle }}</div>
    {%- if detailed %}
    <div class="entry-body">{{ item.templateContent | safe }}</div>
    {%- endif %}
  </li>
{%- endfor %}
</ol>
