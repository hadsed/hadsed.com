{#- Consumes: roles (sorted experience items), detailed (bool) -#}
<ol class="timeline">
{%- for item in roles %}
  <li id="{{ item.fileSlug | roleSlug }}" class="timeline-entry{% if item.data.upcoming %} is-upcoming{% endif %}" style="--i: {{ loop.index0 }}">
    <span class="orb" aria-hidden="true"></span>
    {#- Landing: the whole entry opens its spot on the Experience page, styled as plain text.
        Experience page: a # beside the name links straight to the entry. -#}
    {%- if detailed %}
    <span class="org">{{ item.data.org }}<a class="anchor" href="#{{ item.fileSlug | roleSlug }}" aria-label="Link to {{ item.data.org }}">#</a></span>
    {%- else %}
    <a class="org entry-link" href="/experience/#{{ item.fileSlug | roleSlug }}">{{ item.data.org }}</a>
    {%- endif %}
    {%- set startYear = item.data.start | year -%}
    {%- set endYear = (item.data.end | year) if item.data.end else "now" -%}
    <span class="dates">{% if startYear == endYear %}{{ startYear }}{% else %}{{ startYear }} – {{ endYear }}{% endif %}</span>
    {%- if item.data.role or item.data.subtitle %}
    <div class="role">{%- if item.data.role %}{{ item.data.role }}{% if item.data.subtitle %}, {% endif %}{% endif -%}
      {#- Subtitles can carry inline Markdown links; a bare subtitle with a link field links as a whole -#}
      {%- if item.data.subtitle and item.data.link and "](" not in item.data.subtitle %}<a href="{{ item.data.link }}">{{ item.data.subtitle }}</a>{% elif item.data.subtitle %}{{ item.data.subtitle | inlineLinks | safe }}{% endif -%}
    </div>
    {%- endif %}
    {%- if detailed and (item.templateContent | trim) %}
    <div class="entry-body">{{ item.templateContent | safe }}</div>
    {%- endif %}
  </li>
{%- endfor %}
</ol>
