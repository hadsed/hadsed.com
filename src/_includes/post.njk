---
layout: base.njk
---
{%- set projectsIn = site.appearsIn[page.url] %}
{%- set toc = content | toc %}
{%- if previewSwitcher and projectsIn %}
<script>(function () {
  var pick = new URLSearchParams(location.search).get('appears');
  try { pick = pick || localStorage.getItem('appears-box'); } catch (e) {}
  document.documentElement.dataset.appears = /^[123]$/.test(pick || '') ? pick : '1';
})();</script>
<div class="preview-switcher" role="group" aria-label="Appears-in box (preview only)">
  <span>Box</span><button type="button" data-pick="1">1 Outline</button><button type="button" data-pick="2">2 Gold rule</button><button type="button" data-pick="3">3 Chip</button>
</div>
<script>(function () {
  var root = document.documentElement, box = document.currentScript.previousElementSibling;
  function sync() { box.querySelectorAll('button').forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.pick === root.dataset.appears); }); }
  box.addEventListener('click', function (e) {
    var b = e.target.closest('button'); if (!b) return;
    root.dataset.appears = b.dataset.pick;
    try { localStorage.setItem('appears-box', b.dataset.pick); } catch (err) {}
    var u = new URL(location.href); u.searchParams.set('appears', b.dataset.pick); history.replaceState(null, '', u);
    sync();
  });
  sync();
})();</script>
{%- endif %}
<div class="reading{% if toc.length > 2 %} has-toc{% endif %}">
<div class="reading-main">
<article class="prose">
  <h1>{{ title }}</h1>
  <p class="meta">{{ page.date | readableDate }}</p>
  {%- if projectsIn %}
  <p class="appears"><span class="appears-label">Appears in</span> {% for p in projectsIn %}<a href="{{ p.url }}">{{ p.title }}</a>{% if not loop.last %} {% endif %}{% endfor %}</p>
  {%- endif %}
  {%- set lead = page.inputPath | leadImage if not hero_image else null %}
  {%- if hero_image or lead %}
  <img class="hero" src="{{ (hero_image or lead.src) | assetUrl }}" alt="{{ hero_image_alt or (lead.alt if lead) or '' }}">
  {%- endif %}
  {%- if toc.length > 2 %}
  <details class="toc-inline">
    <summary>Contents</summary>
    {% include "toc.njk" %}
  </details>
  {%- endif %}
  {{ (content | dropLeadFigure if lead else content) | safe }}
</article>
{% include "backlinks.njk" %}
</div>
{%- if toc.length > 2 %}
<aside class="toc-side" aria-label="Contents">
  <p class="label">Contents</p>
  {% include "toc.njk" %}
</aside>
{%- endif %}
</div>
