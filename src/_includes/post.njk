---
layout: base.njk
---
{%- set projectsIn = site.appearsIn[page.url] %}
<article class="prose">
  <p class="kind"><a href="/blog/">Blog</a></p>
  <h1>{{ title }}</h1>
  <p class="meta">{{ page.date | readableDate }}</p>
  {%- if projectsIn %}
  <p class="appears">Appears in {% for p in projectsIn %}<a href="{{ p.url }}">{{ p.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
  {%- endif %}
  {{ content | safe }}
</article>
{% include "backlinks.njk" %}
