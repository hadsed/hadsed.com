---
layout: base.njk
---
{%- set info = site.projectByUrl[page.url] %}
<article class="prose">
  <h1>{{ title }}{% if status %} <span class="status status-{{ status }}">{{ status }}</span>{% endif %}</h1>
  <p class="meta">
    {%- if info.started %}Started {{ info.started | monthYear }}{% endif %}
    {%- if info.started and info.updated %}, last updated {{ info.updated | readableDate }}{% elif info.updated %}Last updated {{ info.updated | readableDate }}{% endif %}
    {%- if link %}<br><a href="{{ link }}">{{ link | replace("https://", "") }}</a>{% endif %}
  </p>
  {%- if image %}
  <img class="hero" src="{{ image | assetUrl }}" alt="{{ image_alt or '' }}">
  {%- endif %}
  {{ content | safe }}
</article>
{%- if info.posts.length %}
<section class="section">
  <h2 class="label">Blog posts</h2>
  <ul class="posts">
    {%- for post in info.posts %}
    <li>
      <a href="{{ post.url }}">{{ post.title }}</a>
      <span class="dates">{{ post.date | readableDate }}</span>
      {%- if post.summary %}<p class="summary">{{ post.summary }}</p>{% endif %}
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}
{%- if info.notes.length %}
<section class="section">
  <h2 class="label">Key notes</h2>
  <ul class="notes-list">
    {%- for note in info.notes %}
    <li><a href="{{ note.url }}">{{ note.title }}</a>{% if note.summary %}<span class="summary">{{ note.summary }}</span>{% endif %}</li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}
