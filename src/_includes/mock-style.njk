<style>
/* Mockup-only additions, built from the site's own tokens. */
.prose h2.kind, .kind { display: block; font-size: 0.75rem; font-weight: 400; color: var(--muted); margin: 0 0 0.6rem; }
.kind a { color: inherit; text-decoration: none; }
.kind a:hover { color: var(--accent); }
.status {
  display: inline-block; vertical-align: middle; margin-left: 0.6rem;
  padding: 0 0.4rem; border: 1px solid var(--rule); border-radius: 3px;
  color: var(--muted); font-size: 0.68rem; line-height: 1.5; letter-spacing: 0.08em; text-transform: uppercase;
}
.status.active { color: var(--glow); border-color: color-mix(in srgb, var(--glow) 60%, transparent); }
.meta .sep { margin: 0 0.4rem; }
.appears { color: var(--muted); font-size: 0.9rem; margin: -1rem 0 1.75rem; }
.appears a { color: var(--text); text-decoration: underline; text-underline-offset: 2px; }

/* Headings keep a stable anchor; a # shows on hover so a section can be linked now
   and pointed at a broken-out note later. */
.prose h2 { font-size: 1.05rem; font-weight: 400; color: var(--accent); margin: 2rem 0 0.6rem; position: relative; }
.prose h2 .anchor { position: absolute; left: -1.1rem; color: var(--muted); text-decoration: none; opacity: 0; }
.prose h2:hover .anchor, .prose h2 .anchor:focus { opacity: 1; }
.prose ul { margin: 0 0 1rem; padding-left: 1.1rem; }
.prose li { margin: 0 0 0.3rem; }
.prose a.stub { text-decoration: underline dotted; text-underline-offset: 2px; }
.broken-out { color: var(--muted); font-size: 0.85rem; margin: -0.2rem 0 0.8rem; }
.broken-out a { color: var(--text); }

/* Embedded visualization: its own sandboxed page inside the normal one */
.embed { margin: 1.25rem 0 1.5rem; }
.embed iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 1px solid var(--rule); border-radius: 3px; background: #0f1520; }
.embed figcaption { color: var(--muted); font-size: 0.8rem; margin-top: 0.4rem; }

/* Project page sections */
.section { margin-top: 2.75rem; max-width: var(--measure); }
.notes-list { list-style: none; margin: 0; padding: 0; }
.notes-list li { margin: 0 0 0.6rem; }
.notes-list .summary { display: block; color: var(--muted); font-size: 0.85rem; }

/* Projects index cards */
.panel .updated { float: right; color: var(--muted); font-size: 0.8rem; }
.panel .counts { margin: 0.6rem 0 0; color: var(--muted); font-size: 0.8rem; }
.panel h3 + .status { margin-left: 0.5rem; }

/* Note backlinks */
.backlinks { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid color-mix(in srgb, var(--rule) 40%, transparent); max-width: var(--measure); }
.backlinks ul { list-style: none; margin: 0; padding: 0; }
.backlinks li { margin: 0 0 1rem; }
.backlinks .where { color: var(--muted); font-size: 0.8rem; margin-left: 0.4rem; }
.backlinks .context { display: block; color: var(--muted); font-size: 0.85rem; margin-top: 0.15rem; }
.backlinks mark { background: none; color: var(--text); text-decoration: underline; text-underline-offset: 2px; }

.mock-tag {
  position: fixed; right: 0.75rem; bottom: 0.75rem; z-index: 3;
  font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--glow); border: 1px solid color-mix(in srgb, var(--glow) 50%, transparent);
  border-radius: 3px; padding: 0.15rem 0.45rem; background: color-mix(in srgb, var(--bg) 80%, transparent);
}
.mock-tag a { color: inherit; }

/* Mockup index page */
.spec { max-width: var(--measure); }
.spec pre { background: color-mix(in srgb, #000 25%, transparent); border: 1px solid color-mix(in srgb, var(--rule) 40%, transparent); border-radius: 3px; padding: 0.8rem 1rem; overflow-x: auto; font-size: 0.8rem; line-height: 1.5; color: var(--text); }
.spec code { font-size: 0.85em; }
.spec table { border-collapse: collapse; width: 100%; margin: 0 0 1rem; font-size: 0.85rem; }
.spec th, .spec td { text-align: left; vertical-align: top; padding: 0.35rem 0.6rem 0.35rem 0; border-bottom: 1px solid color-mix(in srgb, var(--rule) 30%, transparent); }
.spec th { color: var(--muted); font-weight: 400; }

/* Sidebar options (A flat, B two groups split by space, C labeled groups) */
html[data-nav="a"] .mock-nav li[data-v]:not([data-v~="a"]),
html[data-nav="b"] .mock-nav li[data-v]:not([data-v~="b"]),
html[data-nav="c"] .mock-nav li[data-v]:not([data-v~="c"]) { display: none; }
.mock-nav .nav-gap { height: 1.1rem; margin: 0; }
.mock-nav .nav-head { color: var(--muted); font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; margin: 1.15rem 0 0.4rem; }
@media (max-width: 640px) {
  /* phones: one row that scrolls sideways. Fly sits outside the scroller at the right end,
     and the item running into it fades out half-cut, so the row reads as "there's more". */
  .mock-nav .nav-gap, .mock-nav .nav-head { display: none !important; }
  .menu ul.mock-nav { flex-wrap: nowrap; gap: 0; }
  .mock-nav .nav-scroll { flex: 1 1 auto; min-width: 0; }
  .mock-nav .nav-scroll > ul {
    --fade: 2.75rem;
    display: flex; flex-wrap: nowrap; gap: 1.25rem; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 var(--fade-l, 0px), #000 calc(100% - var(--fade)), transparent);
    mask-image: linear-gradient(to right, transparent 0, #000 var(--fade-l, 0px), #000 calc(100% - var(--fade)), transparent);
  }
  .mock-nav .nav-scroll > ul::-webkit-scrollbar { display: none; }
  .mock-nav .nav-scroll > ul.at-end { --fade: 0px; }
  .mock-nav .nav-scroll > ul.scrolled { --fade-l: 1.5rem; }
  .mock-nav .nav-scroll li { flex: none; white-space: nowrap; }
  .mock-nav .fly-item { flex: none; margin-left: 0.75rem !important; }
}
.mock-tag .opt { margin-left: 0.35rem; color: var(--muted); }
.mock-tag .opt.on { color: var(--glow); text-decoration: underline; text-underline-offset: 2px; }
</style>
<div class="mock-tag"><a href="/lab/content/">Mockup</a><span class="sep"> · sidebar</span><a class="opt" href="?nav=a">A</a><a class="opt" href="?nav=b">B</a><a class="opt" href="?nav=c">C</a></div>
<script>
(() => {
  const ul = document.querySelector('.mock-nav .nav-scroll > ul'); if (!ul) return;
  const mark = () => { ul.classList.toggle('scrolled', ul.scrollLeft > 2); ul.classList.toggle('at-end', ul.scrollLeft + ul.clientWidth >= ul.scrollWidth - 2); };
  ul.addEventListener('scroll', mark, { passive: true });
  const cur = [...ul.querySelectorAll('[aria-current="page"]')].find((a) => a.offsetParent);
  // Keep the current page's item clear of the fade.
  const show = () => {
    if (cur && ul.scrollWidth > ul.clientWidth) {
      const limit = ul.getBoundingClientRect().right - 48;
      const over = cur.getBoundingClientRect().right - limit;
      if (over > 0) ul.scrollLeft += over;
    }
    mark();
  };
  addEventListener('load', show);
})();
for (const a of document.querySelectorAll('.mock-tag .opt')) if (a.textContent.toLowerCase() === document.documentElement.dataset.nav) a.classList.add('on');</script>
