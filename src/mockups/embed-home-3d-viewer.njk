<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Home 3D viewer (stand-in)</title>
<style>
  html,body{margin:0;height:100%;background:#0f1520;overflow:hidden;font:11px/1.4 Verdana,sans-serif;color:#8a919c}
  canvas{display:block;width:100%;height:100%;cursor:grab}
  .hint{position:absolute;left:10px;bottom:8px;letter-spacing:.08em;text-transform:uppercase;font-size:10px}
</style></head><body>
<canvas id="c"></canvas><div class="hint">Stand-in viewer · drag to orbit</div>
<script>
// Stand-in for a real three.js scene: a wireframe two-storey house with a gable roof.
const c = document.getElementById('c'), g = c.getContext('2d');
const V = [], E = [];
const box = (x0,y0,z0,x1,y1,z1) => { const b=V.length;
  for (const [x,y,z] of [[x0,y0,z0],[x1,y0,z0],[x1,y0,z1],[x0,y0,z1],[x0,y1,z0],[x1,y1,z0],[x1,y1,z1],[x0,y1,z1]]) V.push([x,y,z]);
  for (const [a,d] of [[0,1],[1,2],[2,3],[3,0],[4,5],[5,6],[6,7],[7,4],[0,4],[1,5],[2,6],[3,7]]) E.push([b+a,b+d,0]); };
box(-4,0,-3,4,5.6,3);            // main volume
box(-4,0,3,-0.5,2.8,5.5);        // garage bump-out
const r=V.length; V.push([-4.4,5.6,-3.4],[4.4,5.6,-3.4],[4.4,5.6,3.4],[-4.4,5.6,3.4],[-4.4,8.2,0],[4.4,8.2,0]);
for (const [a,d] of [[0,1],[2,3],[0,4],[3,4],[1,5],[2,5],[4,5]]) E.push([r+a,r+d,1]);
const opening = (x,y,w,h,z) => { const b=V.length; V.push([x,y,z],[x+w,y,z],[x+w,y+h,z],[x,y+h,z]); for (const [a,d] of [[0,1],[1,2],[2,3],[3,0]]) E.push([b+a,b+d,2]); };
opening(1,0,1,2.2,3); opening(2.6,1,1.2,1.2,3); opening(-3.2,3.6,1.3,1.2,3); opening(-1.2,3.6,1.3,1.2,3); opening(1.5,3.6,1.3,1.2,3);
// ground grid
for (let i=-8;i<=8;i+=2){ const b=V.length; V.push([i,0,-8],[i,0,8],[-8,0,i],[8,0,i]); E.push([b,b+1,3],[b+2,b+3,3]); }
const col = ['#c8cdd5','#e4c56f','#8a919c','rgba(138,145,156,.18)'];
let yaw = 0.7, pitch = 0.32, drag = null, auto = true;
c.onpointerdown = e => { drag = [e.clientX, e.clientY]; auto = false; c.setPointerCapture(e.pointerId); };
c.onpointermove = e => { if (!drag) return; yaw += (e.clientX-drag[0])*0.01; pitch = Math.max(0.05, Math.min(1.2, pitch + (e.clientY-drag[1])*0.01)); drag=[e.clientX,e.clientY]; };
c.onpointerup = () => { drag = null; };
function frame(){
  const w = c.width = c.clientWidth*devicePixelRatio, h = c.height = c.clientHeight*devicePixelRatio;
  if (auto) yaw += 0.003;
  const cy=Math.cos(yaw), sy=Math.sin(yaw), cp=Math.cos(pitch), sp=Math.sin(pitch), f=Math.min(w,h)*1.4;
  const P = V.map(([x,y,z]) => { y-=3.2; const x1=x*cy-z*sy, z1=x*sy+z*cy; const y2=y*cp-z1*sp, z2=y*sp+z1*cp+20; return [w/2+x1*f/z2, h/2-y2*f/z2]; });
  g.lineWidth = devicePixelRatio;
  for (const [a,b,k] of E){ g.strokeStyle=col[k]; g.beginPath(); g.moveTo(...P[a]); g.lineTo(...P[b]); g.stroke(); }
  requestAnimationFrame(frame);
}
frame();
</script></body></html>
